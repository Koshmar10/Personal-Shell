
<expression> ::= <term> { ("+" | "-") <term> };
<term> ::= <power> { ( "*" | "/") <power> };
<power> ::= <identifier> {"^" <identifier>};
<identifier> ::= <id> | <number> | "(" <expression> ")";
<id> ::= STRING;
<number> ::= "0" | <non zero digit> {<digit>};
<digit> ::= "0" | <non zero digit>;
<non zero digit> ::=  "1" | "2" | "3" | "4" | "5" | "6" | "7" | "8" | "9"; 